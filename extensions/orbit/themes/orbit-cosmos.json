{
	"$schema": "vscode://schemas/color-theme",
	"name": "Orbit Cosmos",
	"type": "dark",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function": "#6cb6ff",
		"method": "#6cb6ff",
		"function.defaultLibrary": "#8ec0ff",
		"class": "#f5c451",
		"interface": {
			"foreground": "#f5c451",
			"italic": true
		},
		"type": "#f5c451",
		"typeParameter": {
			"foreground": "#ffb86b",
			"italic": true
		},
		"enum": "#f5c451",
		"enumMember": "#ffb86b",
		"namespace": "#d0b6ff",
		"parameter": {
			"foreground": "#ffcfa8",
			"italic": true
		},
		"property": "#9ecbff",
		"variable": "#e4e6fb",
		"variable.defaultLibrary": "#d0b6ff",
		"decorator": "#f5c451",
		"macro": "#f472b6",
		"label": "#f472b6"
	},
	"colors": {
		"focusBorder": "#8b7bff",
		"foreground": "#dfe1f7",
		"descriptionForeground": "#828396",
		"errorForeground": "#f87171",
		"icon.foreground": "#aeb0c5",
		"widget.border": "#1f202d",
		"widget.shadow": "#00000066",
		"selection.background": "#302d5a",
		"sash.hoverBorder": "#8b7bff",
		"titleBar.activeBackground": "#05040d73",
		"titleBar.inactiveBackground": "#05040d8c",
		"titleBar.activeForeground": "#d6d8f0",
		"titleBar.inactiveForeground": "#828396",
		"titleBar.border": "#00000000",
		"activityBar.background": "#05040d59",
		"activityBar.foreground": "#d6d8f0",
		"activityBar.inactiveForeground": "#828396",
		"activityBar.border": "#00000000",
		"activityBar.activeBorder": "#8b7bff",
		"activityBarBadge.background": "#8b7bff",
		"activityBarBadge.foreground": "#ffffff",
		"activityBarTop.foreground": "#d6d8f0",
		"activityBarTop.inactiveForeground": "#828396",
		"activityBarTop.activeBorder": "#8b7bff",
		"sideBar.background": "#0706129e",
		"sideBar.foreground": "#c2c4db",
		"sideBar.border": "#00000000",
		"sideBarTitle.foreground": "#d6d8f0",
		"sideBarSectionHeader.background": "#00000000",
		"sideBarSectionHeader.border": "#00000000",
		"editor.background": "#0a0918cc",
		"editor.foreground": "#e4e6fb",
		"editorLineNumber.foreground": "#555a80",
		"editorLineNumber.activeForeground": "#8b7bff",
		"editorCursor.foreground": "#8b7bff",
		"editor.selectionBackground": "#332f5f",
		"editor.inactiveSelectionBackground": "#201e3c",
		"editor.lineHighlightBackground": "#8b7bff12",
		"editor.lineHighlightBorder": "#00000000",
		"editor.findMatchBackground": "#605018",
		"editor.findMatchHighlightBackground": "#383019",
		"editor.wordHighlightBackground": "#1f1d3a",
		"editorIndentGuide.background1": "#191a27",
		"editorIndentGuide.activeBackground1": "#353645",
		"editorWhitespace.foreground": "#2b2c3a",
		"editorGutter.addedBackground": "#4ade80",
		"editorGutter.modifiedBackground": "#8b7bff",
		"editorGutter.deletedBackground": "#f87171",
		"editorWidget.background": "#13112bf5",
		"editorWidget.border": "#1f202d",
		"editorSuggestWidget.background": "#13112bf7",
		"editorSuggestWidget.selectedBackground": "#302d5a",
		"editorHoverWidget.background": "#13112bf7",
		"editorGroupHeader.tabsBackground": "#00000000",
		"editorGroupHeader.tabsBorder": "#00000000",
		"editorGroup.border": "#1f202d",
		"tab.activeBackground": "#1b18408c",
		"tab.inactiveBackground": "#00000000",
		"tab.activeForeground": "#d6d8f0",
		"tab.inactiveForeground": "#828396",
		"tab.border": "#00000000",
		"tab.activeBorderTop": "#8b7bff",
		"tab.hoverBackground": "#1b184059",
		"tab.unfocusedActiveBorderTop": "#3f3a76",
		"panel.background": "#070612b2",
		"panel.border": "#00000000",
		"panelTitle.activeBorder": "#8b7bff",
		"panelTitle.activeForeground": "#d6d8f0",
		"panelTitle.inactiveForeground": "#828396",
		"statusBar.background": "#05040d73",
		"statusBar.foreground": "#828396",
		"statusBar.border": "#00000000",
		"statusBar.noFolderBackground": "#05040d73",
		"statusBar.debuggingBackground": "#8b7bff",
		"statusBarItem.remoteBackground": "#8b7bff",
		"statusBarItem.remoteForeground": "#ffffff",
		"statusBarItem.hoverBackground": "#191a27",
		"list.activeSelectionBackground": "#8b7bff4c",
		"list.activeSelectionForeground": "#d6d8f0",
		"list.inactiveSelectionBackground": "#8b7bff24",
		"list.hoverBackground": "#8b7bff1f",
		"list.focusOutline": "#00000000",
		"list.highlightForeground": "#8b7bff",
		"input.background": "#ffffff0d",
		"input.border": "#1f202d",
		"input.foreground": "#d6d8f0",
		"input.placeholderForeground": "#828396",
		"inputOption.activeBorder": "#8b7bff",
		"dropdown.background": "#13112bf5",
		"dropdown.border": "#1f202d",
		"button.background": "#8b7bff",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#998bff",
		"button.secondaryBackground": "#21222f",
		"button.secondaryForeground": "#d6d8f0",
		"badge.background": "#8b7bff",
		"badge.foreground": "#ffffff",
		"progressBar.background": "#8b7bff",
		"textLink.foreground": "#8b7bff",
		"textLink.activeForeground": "#a295ff",
		"scrollbarSlider.background": "#25263499",
		"scrollbarSlider.hoverBackground": "#353645aa",
		"scrollbarSlider.activeBackground": "#8b7bffaa",
		"quickInput.background": "#100e24f5",
		"quickInputList.focusBackground": "#302d5a",
		"pickerGroup.foreground": "#8b7bff",
		"menu.background": "#100e24f7",
		"menu.selectionBackground": "#302d5a",
		"menu.border": "#1f202d",
		"terminal.background": "#00000000",
		"terminal.foreground": "#e4e6fb",
		"terminalCursor.foreground": "#a99dff",
		"terminal.ansiBlue": "#5b9dff",
		"terminal.ansiMagenta": "#b48cff",
		"terminal.ansiGreen": "#4ade80",
		"terminal.ansiYellow": "#f5c451",
		"terminal.ansiRed": "#ff5c7a",
		"terminal.ansiCyan": "#22d3ee",
		"breadcrumb.foreground": "#828396",
		"breadcrumb.focusForeground": "#d6d8f0",
		"notifications.background": "#13112bf5",
		"notifications.border": "#1f202d",
		"notificationToast.border": "#1f202d",
		"diffEditor.insertedLineBackground": "#22c55e1c",
		"diffEditor.removedLineBackground": "#ef44441c",
		"diffEditor.insertedTextBackground": "#22c55e33",
		"diffEditor.removedTextBackground": "#ef444433",
		"gitDecoration.modifiedResourceForeground": "#8ec0ff",
		"gitDecoration.untrackedResourceForeground": "#4ade80",
		"minimap.background": "#0a091899",
		"editorOverviewRuler.border": "#00000000",
		"tree.indentGuidesStroke": "#1f202d",
		"checkbox.border": "#1f202d",
		"editorGutter.background": "#0a091800",
		"editorGroupHeader.noTabsBackground": "#00000000",
		"tab.unfocusedActiveBackground": "#1b184059",
		"breadcrumb.background": "#00000000",
		"editorStickyScroll.background": "#0a0918eb",
		"welcomePage.background": "#00000000",
		"welcomePage.tileBackground": "#13112bb2",
		"welcomePage.tileHoverBackground": "#1b1840cc",
		"editorGroup.emptyBackground": "#00000000",
		"peekViewEditor.background": "#0d0c1ff5",
		"peekViewResult.background": "#0d0c1ff5",
		"terminal.selectionBackground": "#8b7bff55",
		"terminal.ansiBlack": "#1c1b33",
		"terminal.ansiWhite": "#d6d8f0",
		"terminal.ansiBrightBlack": "#7479a6",
		"terminal.ansiBrightRed": "#ff8fa3",
		"terminal.ansiBrightGreen": "#86efac",
		"terminal.ansiBrightYellow": "#fde68a",
		"terminal.ansiBrightBlue": "#8ec0ff",
		"terminal.ansiBrightMagenta": "#d0b6ff",
		"terminal.ansiBrightCyan": "#7ee8f5",
		"terminal.ansiBrightWhite": "#ffffff",
		"editorBracketHighlight.foreground1": "#f5c451",
		"editorBracketHighlight.foreground2": "#b48cff",
		"editorBracketHighlight.foreground3": "#6cb6ff",
		"editorBracketHighlight.unexpectedBracket.foreground": "#ff5c7a",
		"editorBracketMatch.background": "#8b7bff2e",
		"editorBracketMatch.border": "#8b7bff80",
		"editorError.foreground": "#ff5c7a",
		"editorWarning.foreground": "#f5c451",
		"editorInfo.foreground": "#6cb6ff",
		"gitDecoration.deletedResourceForeground": "#ff7a93",
		"gitDecoration.ignoredResourceForeground": "#5d6188",
		"gitDecoration.conflictingResourceForeground": "#ffb86b"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6b7099",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"comment.block.documentation storage.type",
				"comment.block.documentation keyword",
				"comment.block.documentation entity.name.type",
				"comment.block.documentation variable"
			],
			"settings": {
				"foreground": "#8b7bff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python"
			],
			"settings": {
				"foreground": "#b48cff"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.control.import",
				"keyword.control.flow",
				"keyword.other.using",
				"keyword.control.at-rule"
			],
			"settings": {
				"foreground": "#f472b6"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.language.this",
				"variable.language.super",
				"variable.parameter.function.language.special.self"
			],
			"settings": {
				"foreground": "#f472b6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#9aa0c7"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#6ee7b7"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"string.regexp",
				"constant.other.placeholder",
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#22d3ee"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other",
				"support.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#ffb86b"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"meta.function-call.generic",
				"variable.function"
			],
			"settings": {
				"foreground": "#6cb6ff"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"storage.type.primitive",
				"support.type.primitive",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#f5c451"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator",
				"punctuation.decorator",
				"meta.annotation",
				"storage.type.annotation"
			],
			"settings": {
				"foreground": "#f5c451",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable",
				"variable.other.readwrite"
			],
			"settings": {
				"foreground": "#e4e6fb"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#ffcfa8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.variable.property",
				"meta.object-literal.key",
				"support.type.property-name",
				"entity.name.tag.yaml",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#9ecbff"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#ff7a93"
			}
		},
		{
			"scope": [
				"support.class.component",
				"entity.name.tag support.class.component"
			],
			"settings": {
				"foreground": "#f5c451"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#b48cff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element"
			],
			"settings": {
				"foreground": "#f5c451",
				"fontStyle": ""
			}
		},
		{
			"scope": [
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#6cb6ff",
				"fontStyle": ""
			}
		},
		{
			"scope": [
				"support.type.property-name.css",
				"meta.property-name.css",
				"support.type.vendored.property-name"
			],
			"settings": {
				"foreground": "#9ecbff"
			}
		},
		{
			"scope": [
				"variable.css",
				"variable.scss",
				"variable.other.less",
				"variable.argument.css"
			],
			"settings": {
				"foreground": "#ffcfa8"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section",
				"punctuation.definition.heading"
			],
			"settings": {
				"foreground": "#b48cff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#ffb86b",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#ffcfa8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code.block",
				"markup.raw"
			],
			"settings": {
				"foreground": "#6ee7b7"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"meta.link"
			],
			"settings": {
				"foreground": "#6cb6ff"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#6b7099",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"punctuation.definition.list.begin",
				"beginning.punctuation.definition.list"
			],
			"settings": {
				"foreground": "#f472b6"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file"
			],
			"settings": {
				"foreground": "#4ade80"
			}
		},
		{
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file"
			],
			"settings": {
				"foreground": "#ff5c7a"
			}
		},
		{
			"scope": [
				"markup.changed",
				"meta.diff.range"
			],
			"settings": {
				"foreground": "#f5c451"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ff5c7a"
			}
		}
	]
}
